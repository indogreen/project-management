# Server for `npm run dev`
DEV_HOST=localhost
DEV_PORT=5174
DEV_ALLOWED_HOSTS=app-pm-idg.zed.ai.id

# Server for `npm run preview`
PREVIEW_HOST=localhost
PREVIEW_PORT=4174

# HMR for `npm run dev`
HMR_HOST=localhost
HMR_PORT=24679
HMR_PROTOCOL=wss
HMR_CLIENT_PORT=443

# Public (exposed to browser)
PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
PUBLIC_STORAGE_BASE_URL=http://127.0.0.1:8000/storage
PUBLIC_PWA_ENABLED=true

# Internal API (server-side, for SSR / server-to-server calls)
INTERNAL_API_BASE_URL=http://localhost:8004/api
