{
  "name": "indogreen-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "node -e \"const fs=require('fs'); if (!fs.existsSync('.env') && fs.existsSync('.env.example')) fs.copyFileSync('.env.example', '.env');\" && (svelte-kit sync || echo '')",
    "check": "node -e \"const fs=require('fs'); if (!fs.existsSync('.env') && fs.existsSync('.env.example')) fs.copyFileSync('.env.example', '.env');\" && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@fontsource/fira-mono": "^5.3.0",
    "@neoconfetti/svelte": "^2.0.0",
    "@sveltejs/adapter-auto": "^6.1.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^16.5.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@tailwindplus/elements": "^1.0.22",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "sweetalert2": "^11.26.25"
  }
}
